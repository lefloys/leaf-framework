uniform {
	UniformBuffer UiDraw;
	Sampler2D UiTexture;
}

layout UiDraw : struct {
	vec2 viewport_size;
	vec2 translation;
	f32 texture_mode;
	f32 padding;
};

struct Point {
	vec2 position;
	vec2 uv;
	vec4 color;
};

struct Vertex {
	vec4 position;
	vec2 uv;
	vec4 color;
};

@stage : vertex
fn main(Point point) -> Vertex : position(clip), uv(smooth), color(smooth) {
	vec2 pixel = point.position + UiDraw.translation;
	vec2 ndc = vec2(
		pixel.x / UiDraw.viewport_size.x * 2.0 - 1.0,
		1.0 - pixel.y / UiDraw.viewport_size.y * 2.0
	);
	return Vertex(vec4(ndc, 0.0, 1.0), point.uv, point.color);
}

@stage : fragment
fn main(Vertex vertex) -> vec4 {
	if (UiDraw.texture_mode < 0.5) {
		return vertex.color;
	}
	return sample(UiTexture, vertex.uv) * vertex.color;
}
